# Optional environment-variable reference for non-IntelliJ runs.
# Direct IntelliJ Run already uses these local defaults; no .env file is required.
DB_URL=jdbc:mysql://localhost:3306/jerseysee?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=password

APP_UPLOAD_DIR=uploads

# Production requires a private random Base64 key (32+ bytes); never commit its value.
JWT_SECRET_BASE64=
# true on HTTPS hosting; false only for local HTTP development.
AUTH_SECURE_COOKIES=true

# Keep existing SQL settings for accounts, orders and stock. Cloudinary stores uploaded photos.
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
